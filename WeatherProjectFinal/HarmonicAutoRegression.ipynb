    "def drop_incomplete_years (df,date):\n",
    "    for date in df['yyyy'].tolist():\n",
    "        if len(df[df['yyyy']==date]) != 12:\n",
    "            df = df[df['yyyy'] != date]\n",
    "            date = date + 1\n",
    "        else:\n",
    "            date = date + 1\n",
    "    return df\n",
    "\n",
